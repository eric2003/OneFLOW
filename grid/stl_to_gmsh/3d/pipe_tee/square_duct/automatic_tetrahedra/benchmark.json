    "junction": "Sharp planar T intersection with exact shared coordinates; no Boolean intersection."
  },
  "operating_modes": {
    "main_inlets": {"main_left": "inflow", "main_right": "inflow", "branch": "outflow"},
    "branch_inlet": {"branch": "inflow", "main_left": "outflow", "main_right": "outflow"}
  },
  "meshing": {
    "default_route": "STL",
    "reference_route": "OCC reserved for follow-up",
    "element_type": "TETRA_4",
    "initial_mesh_size": 0.75,
    "scope": "Coarse smoke-test mesh; no boundary layers or local refinement."
  },
  "cfd_scope": "Two-step runtime smoke test only; no physical-accuracy claim."
