{
  "schema": "oneflow.reference-benchmark",
  "version": 1,
  "id": "square_duct_pipe_tee",
  "title": "Square-duct T-junction geometry and mesh handoff benchmark",
  "status": {
    "geometry_and_mesh_pipeline": "implemented_not_verified",
    "cfd_smoke": "configured_not_yet_verified",
    "physical_validation": "not_started"
